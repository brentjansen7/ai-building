# Database
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://arbitrage_user:your_secure_password_here@localhost:5432/arbitrage

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_KEY=dev-key-change-in-production
API_HOST=0.0.0.0
API_PORT=8000

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Discord (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Proxy Pool (Optional - Bright Data / Smartproxy)
# Kommagescheiden lijst van proxies: http://user:pass@host:port,http://...
PROXY_LIST=

# eBay Developer API (gratis op developer.ebay.com)
EBAY_APP_ID=your_ebay_app_id

# Vinted Account Tokens (kommagescheiden, meerdere accounts voor hogere rate limits)
# Verkrijg via: inloggen op vinted.nl, network tab, kopieer Bearer token uit headers
VINTED_TOKENS=token1,token2

# Scraper Settings
SCRAPER_RATE_LIMIT=50  # requests per minute
SCRAPER_TIMEOUT=30     # seconds
SCRAPER_RETRY_ATTEMPTS=3

# AI Model Settings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DEVICE=cpu  # or cuda if GPU available

# Price Estimation
XGB_MODEL_PATH=./models/price_estimator.pkl
CONFIDENCE_THRESHOLD=0.70
MIN_PROFIT_EUR=30
MIN_PROFIT_PCT=0.25

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_FACEBOOK_SCRAPER=false
ENABLE_CATAWIKI_SCRAPER=true
ENABLE_BVA_AUCTIONS_SCRAPER=true
ENABLE_TROOSTWIJK_SCRAPER=false
ENABLE_AUCTIONET_SCRAPER=true
