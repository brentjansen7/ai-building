# Database
DATABASE_URL=postgresql+asyncpg://vastgoed_user:password@localhost:5432/vastgoed_ai
DATABASE_URL_SYNC=postgresql://vastgoed_user:password@localhost:5432/vastgoed_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# AI APIs
ANTHROPIC_API_KEY=sk-ant-...

# Notifications
TELEGRAM_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwXyz
TELEGRAM_CHAT_ID=987654321
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
ALERT_EMAIL=brent@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=brent@gmail.com
SMTP_PASS=app-password-here

# Extension API
EXTENSION_API_KEY=change_this_to_a_random_32_char_key
API_SECRET_KEY=change_this_to_another_random_key

# Deal alert thresholds
MIN_DEAL_SCORE=70
MIN_ROI_PERCENTAGE=15.0
MIN_PROFIT=30000
ALERT_GRADES=A,B

# Proxy (comma-separated list)
# PROXY_LIST=http://user:pass@proxy1.com:8080,http://user:pass@proxy2.com:8080
PROXY_LIST=

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
